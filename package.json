{
  "name": "essay-eval",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @essay/api --filter @essay/web dev",
    "build": "pnpm --filter @essay/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @essay/api db:migrate:local",
    "db:seed": "pnpm --filter @essay/api db:seed:local",
    "deploy": "pnpm build && pnpm --filter @essay/api deploy"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
